{
  "id": "docintel02",
  "name": "02 Preprocess",
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "is-image",
              "leftValue": "={{ $json.mime }}",
              "rightValue": "application/pdf",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Is image",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $json.file_path }}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "name": "Read file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "operation": "resize",
        "dataPropertyName": "data",
        "width": 1600,
        "height": 1600,
        "resizeOption": "onlyIfLarger",
        "options": {}
      },
      "name": "Resize image",
      "type": "n8n-nodes-base.editImage",
      "typeVersion": 1,
      "position": [
        780,
        0
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('Start').first().json.file_path }}",
        "dataPropertyName": "data",
        "options": {}
      },
      "name": "Write file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1040,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: $('Start').first().json }];\n"
      },
      "name": "Restore",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst MAX_PAGES = 10;\n\nconst doc = $input.first().json;\nconst raw = fs.readFileSync(doc.file_path).toString('latin1');\ndoc.pages = (raw.match(/\\/Type\\s*\\/Page(?![s\\w])/g) || []).length;\n\nif (doc.pages > MAX_PAGES) {\n  doc.status = 'failed';\n  doc.reason = `PDF has ${doc.pages} pages, the limit is ${MAX_PAGES}`;\n}\nreturn [{ json: doc }];\n"
      },
      "name": "Count PDF pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        220
      ]
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Is image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is image": {
      "main": [
        [
          {
            "node": "Read file",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Count PDF pages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read file": {
      "main": [
        [
          {
            "node": "Resize image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resize image": {
      "main": [
        [
          {
            "node": "Write file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write file": {
      "main": [
        [
          {
            "node": "Restore",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "docintel07"
  },
  "active": false
}
